#!/bin/sh
set -eu

secrets_directory=/var/lib/absolutejs
secrets_file=${secrets_directory}/secrets.enc.json

chown 0:0 "${secrets_directory}"
chmod 0700 "${secrets_directory}"

if [ -L "${secrets_file}" ]; then
	echo "witness encrypted secret state must not be a symbolic link" >&2
	exit 1
fi
if [ -e "${secrets_file}" ]; then
	if [ ! -f "${secrets_file}" ]; then
		echo "witness encrypted secret state must be a regular file" >&2
		exit 1
	fi
	chown 65532:65532 "${secrets_file}"
	chmod 0600 "${secrets_file}"
fi

chown 65532:65532 "${secrets_directory}"
